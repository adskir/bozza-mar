{% from "icons.njk" import icon %}
{% set waInfo = "https://wa.me/" + site.whatsapp + "?text=" + ("Ciao Mar! Vorrei informazioni su Viaja con MAR." | waText) %}
<section class="hero vcm">
  <div class="wrap">
    <div>
      <p class="kick">Viaja con MAR</p>
      <h1>Viaggia con me ai <em>congressi di salsa e timba</em></h1>
      <p class="lead">Promozione e vendita di biglietti e codici sconto per congressi di salsa e timba.</p>
      <p class="sub"><span class="ph">[come funziona: biglietti, sconti, viaggio insieme]</span></p>
      <div class="cta"><a class="btn" href="{{ waInfo }}" target="_blank" rel="noopener">Chiedi informazioni</a></div>
    </div>
    <div class="portrait">
      <img src="/foto/el-timbon.jpg" alt="Mar La Criolla balla a un evento di timba" loading="eager" sizes="(max-width: 860px) 90vw, 430px">
