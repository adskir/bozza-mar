  </div>
</section>

<section class="vcm">
  <div class="wrap">
    <h2>Prossimi eventi</h2>
    <div class="grid3">
      {% for i in [1,2,3] %}
      <div class="card ev">
        <span class="who"><span class="ph">[data · città]</span></span>
        <h3><span class="ph">[nome congresso / festival]</span></h3>
