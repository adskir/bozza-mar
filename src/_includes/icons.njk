{%- macro social(list, mini) -%}
<ul class="social{% if mini %} mini{% endif %}" aria-label="Contatti e social di Mar">{% for s in list %}<li><a class="s-{{ s.k }}{% if s.k == "wa" %} wa-s{% endif %}" href="{{ s.u }}" aria-label="{{ s.n }}" target="_blank" rel="noopener"><span class="ic">{{ icon(s.k) }}</span><span class="sn">{{ s.n }}<small>{{ s.h }}</small></span></a></li>{% endfor %}</ul>
{%- endmacro -%}
