<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="website">
<meta property="og:locale" content="it_IT">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta name="theme-color" content="#15111D">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='16' fill='%2315111D'/%3E%3Ctext x='32' y='44' text-anchor='middle' font-family='Arial Black,Arial' font-weight='900' font-size='34' fill='%23FFB627'%3EM%3C/text%3E%3C/svg%3E">
<link rel="preload" href="/assets/fonts/bricolage-grotesque-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/style.css">
{% if schema %}<script type="application/ld+json">{{ schema | dump | safe }}</script>{% endif %}
</head>
<body class="{{ bodyClass }}">
<a class="skip" href="#main">Vai al contenuto</a>
<header class="top">
  <div class="wrap">
    <a class="brand" href="/">Mar <span>La Criolla</span></a>
    <nav class="nav" id="nav" aria-label="Menu principale">
      {% set links = [["/lezioni-private-bari/","Lezioni a Bari"],["/chi-sono/","Chi sono"],["/video/","Video"],["/blog/","Blog"],["/online/","Online"]] %}
      {% for l in links %}<a href="{{ l[0] }}"{% if page.url == l[0] %} aria-current="page"{% endif %}>{{ l[1] }}</a>{% endfor %}
    </nav>
    <a class="btn small" href="/prenota/">Prenota</a>
    <button class="burger" id="burger" aria-label="Apri il menu" aria-expanded="false" aria-controls="nav"><span></span><span></span></button>
  </div>
</header>

<main id="main">
{{ content | safe }}
</main>

<footer class="foot">
  <div class="wrap">
    <div>
      <a class="brand" href="/">Mar <span>La Criolla</span></a>
      <p>Salsa, timba, bachata e folclore peruviano.<br>Lezioni private a Bari, Barcellona e online.</p>
    </div>
    <nav aria-label="Pagine">
      <a href="/lezioni-private-bari/">Lezioni private a Bari</a>
      <a href="/prenota/">Prenota</a>
      <a href="/chi-sono/">Chi sono</a>
      <a href="/video/">Video</a>
      <a href="/blog/">Blog</a>
      <a href="/online/">Scuola online</a>
    </nav>
    <p class="credit">© {{ "" | year }} Mar La Criolla · Sito realizzato da <a href="https://clickbari.it" target="_blank" rel="noopener">ClickBari</a></p>
  </div>
</footer>

<!-- Assistente: primo contatto automatico -->
<div class="bot" id="bot" hidden>
  <div class="bot-head"><b>Mar La Criolla</b><span>Ti rispondo in pochi secondi</span><button id="botClose" aria-label="Chiudi">×</button></div>
  <div class="bot-body" id="botBody" aria-live="polite"></div>
  <div class="bot-opts" id="botOpts"></div>
</div>
<button class="bot-fab" id="botFab" aria-label="Apri la chat"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H9l-5 4v-4H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"/></svg><span>Chatta con Mar</span></button>

<script>window.MAR={wa:"{{ site.whatsapp }}"};</script>
<script src="/assets/app.js" defer></script>
</body>
</html>
